<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFavoriteItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/ivFavoriteFlower"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/tvFavoriteFlowerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rose Bouquet"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/tvFavoriteFlowerCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bouquet"
                android:textSize="14sp"
                android:textColor="#777777" />

            <TextView
                android:id="@+id/tvFavoriteFlowerPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="$24.99"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E91E63" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivFavoriteIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:src="@android:drawable/btn_star_big_on" />

    </LinearLayout>

</androidx.cardview.widget.CardView>